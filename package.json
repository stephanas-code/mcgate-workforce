{
  "name": "mcgate-workforce",
  "private": true,
  "version": "1.0.0",
  "description": "McGate Workforce Enterprise Operations Platform",
  "author": "McGate Technologies <dev@mcgate.tech>",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server/apiEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:exe": "npm run build && electron-builder --win nsis portable",
    "build:rpm": "npm run build && electron-builder --linux rpm AppImage",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sql.js": "^1.4.11",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "tech.mcgate.workforce",
    "productName": "McGate Workforce",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/mcgate.sqlite",
        "to": "data/mcgate.sqlite"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "McGate Workforce"
    },
    "linux": {
      "target": [
        "rpm",
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "McGate Technologies <dev@mcgate.tech>",
      "vendor": "McGate Technologies",
      "synopsis": "McGate Workforce Enterprise Operations Platform",
      "description": "Enterprise workforce, attendance, task, and project governance platform."
    }
  }
}
